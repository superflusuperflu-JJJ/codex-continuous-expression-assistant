{
  "manifest_version": 3,
  "name": "连续表达原型 · 浏览器采集",
  "version": "0.1.2",
  "description": "仅在本地应用开启表达时记录选区；Option 点击图片或链接明确纳入素材。",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "查看本地采集连接"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
